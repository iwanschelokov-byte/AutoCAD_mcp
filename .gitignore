# User-specific MCP config (contains local paths)
.mcp.json

# Revit MCP test files (not part of this project)
node_modules/
revit-test/

# Build outputs. Matched anywhere rather than per-project, so adding a project
# does not silently start committing its bin/ - which is how a self-contained
# publish (hundreds of runtime DLLs) nearly got checked in.
**/bin/
**/obj/
autocad-plugin/src/AutoCADMCP.Server/publish/

# Staged bundle and installer artifacts (rebuilt by build/build-all.ps1).
# The per-target DLLs under dist/net48 and dist/net8.0-windows ARE committed,
# so users can install without a .NET SDK.
autocad-plugin/dist/AutoCADMCPPlugin.bundle/
autocad-plugin/dist/server/
autocad-plugin/dist/agent/
autocad-plugin/dist/*.exe
autocad-plugin/dist/*.zip

# Python
__pycache__/
*.pyc
*.pyo
.env

# IDE
.vs/
.vscode/
*.user
*.suo

# Claude Code
.claude/

# Test drawings
*.dwg

# Demo/test scripts (keep only source)
autocad-plugin/demo_*.py
autocad-plugin/test_*.py
autocad-plugin/fix_*.py
autocad-plugin/add_*.py
autocad-plugin/redraw_*.py
autocad-plugin/draw_twh28*.py
autocad-plugin/manual_dims.py
autocad-plugin/twh28_details.py

# OS
Thumbs.db
Desktop.ini
.DS_Store
